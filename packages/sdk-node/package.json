{
  "name": "@ethioshield/sdk-node",
  "version": "0.1.0",
  "description": "Open-source Node.js SDK for EthioShield request inspection, policy evaluation, and Express protection.",
  "license": "Apache-2.0",
  "author": "EthioShield contributors",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daufm/etshield.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/Daufm/etshield#readme",
  "bugs": {
    "url": "https://github.com/Daufm/etshield/issues"
  },
  "keywords": [
    "security",
    "sdk",
    "express",
    "waf",
    "xss",
    "sql-injection",
    "rate-limit",
    "nodejs"
  ],
  "publishConfig": {
